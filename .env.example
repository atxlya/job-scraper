# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=5
GEMINI_DAILY_CAP=250
HTTP_MIN_INTERVAL_S=2.5
DATABASE_URL=sqlite:///data/jobs.db
TZ=Asia/Kolkata
# Weekly backup copy target, e.g. user@my-mac:/Users/me/job-scraper-backups
BACKUP_PUSH_TARGET=
# Dashboard login: run `python -m app.cli set-password` and paste the line it prints.
DASHBOARD_PASSWORD_HASH=
# Where you open the dashboard (e.g. http://my-pi:8000). Adds a link to Telegram alerts.
DASHBOARD_URL=
